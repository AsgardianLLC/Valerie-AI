# ---------------------------------------------------------------------------
# Valerie AI - environment variables
# Copy this file to .env (local dev) and to your Vercel project's
# Environment Variables settings (production). Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Supabase (auth + database) ----------------------------------------------
# Project Settings -> API in your Supabase dashboard.
# The anon key is safe to expose to the browser (hence NEXT_PUBLIC_) - it
# only grants what your Row Level Security policies allow, and we don't use
# it for privileged writes; Prisma with DATABASE_URL does the real DB work
# server-side.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Database ----------------------------------------------------------------
# Project Settings -> Database -> Connection string -> URI (use the
# "Transaction" pooler string on port 6543 for serverless/Vercel; Prisma
# needs pgbouncer=true and a direct connection for migrations - see README).
DATABASE_URL="postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Admin bypass -------------------------------------------------------------
# Comma-separated list of emails that are exempt from rate limits & billing.
ADMIN_EMAILS="wxwrobjustice@gmail.com"

# --- AI providers --------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="dall-e-3"

# --- Stripe billing -------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- App config -------------------------------------------------------------
FREE_MESSAGE_LIMIT="40"
# Used as the OAuth/Stripe redirect base since NEXTAUTH_URL no longer exists.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
